@model IEnumerable<ContractMonthlyClaimSystem.Models.Claim>
@{
    ViewData["Title"] = "Track Claim";
}

<div class="container mt-4">
    <h2 class="mb-3">Track Your Claims</h2>
    <table class="table table-striped table-purple-aqua">
        <thead>
            <tr>
                <th>Claim ID</th>
                <th>Module</th>
                <th>Faculty</th>
                <th>Hours</th>
                <th>Rate</th>
                <th>Sessions</th>
                <th>Total(R)</th>
                <th>Status</th>
                <th>Date</th>
            </tr>

        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ClaimID</td>
                    <td>@item.ModuleName</td>
                    <td>@item.FacultyName</td>
                    <td>@item.NumberOfHours</td>
                    <td>@item.HourlyRate</td>
                    <td>@item.NumberOfSessions</td>
                    <td>@item.TotalAmount</td>
                    <td>@item.ClaimStatus</td>
                    <td>@item.CreatingDate.ToString("yyyy-MM-dd")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
