@model IEnumerable<ContractMonthlyClaimSystem.Models.Claim>
@{
    ViewData["Title"] = "Manager Approval";
}

<div class="container mt-4">
    <h2 class="mb-3">Manager Approval</h2>
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info">@TempData["Message"]</div>
    }

    <table class="table table-striped table-purple-aqua">
        <thead>
            <tr>
                <th>ID</th>
                <th>Module</th>
                <th>Faculty</th>
                <th>Hours</th>
                <th>Rate</th>
                <th>Sessions</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ClaimID</td>
                    <td>@item.ModuleName</td>
                    <td>@item.FacultyName</td>
                    <td>@item.NumberOfHours</td>
                    <td>@item.HourlyRate</td>
                    <td>@item.NumberOfSessions</td>
                    <td>@item.ClaimStatus</td>
                    <td>
                        <button class="btn btn-success btn-sm" onclick="openRemarksModal('@item.ClaimID','Approve')">Approve</button>
                        <button class="btn btn-danger btn-sm" onclick="openRemarksModal('@item.ClaimID','Reject')">Reject</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Modal identical to coordinator but posts to Manager controller -->
    <div class="modal fade" id="remarksModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="SubmitDecision" asp-controller="AcademicManager" method="post">
                    <div class="modal-header"><h5 class="modal-title">Add Remarks</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                    <div class="modal-body">
                        <input type="hidden" id="claimId" name="claimId" />
                        <input type="hidden" id="actionType" name="actionType" />
                        <textarea class="form-control" name="remarks" placeholder="Enter remarks (optional)"></textarea>
                    </div>
                    <div class="modal-footer"><button type="submit" class="btn btn-primary">Submit</button></div>
                </form>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        function openRemarksModal(id, actionType) {
            document.getElementById('ClaimId').value = id;
            document.getElementById('actionType').value = actionType;
            var modal = new bootstrap.Modal(document.getElementById('remarksModal'));
            modal.show();
        }
    </script>
}
