@model IEnumerable<ContractMonthlyClaimSystem.Models.Claim>
@{
    ViewData["Title"] = "HR - Approved Claims";
}

<div class="container mt-4">
    <h2>HR - Claims Ready for Payment</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }

    <table class="table table-striped table-purple-aqua">
        <thead>
            <tr>
                <th>ID</th>
                <th>Module</th>
                <th>Lecturer</th>
                <th>Hours</th>
                <th>Total (R)</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ClaimID</td>
                    <td>@item.ModuleName</td>
                    <td>@item.LecturerName</td> <!-- Updated to use LecturerName -->
                    <td>@item.NumberOfHours</td>
                    <td>@item.TotalAmount.ToString("F2")</td> <!-- Format as currency -->
                    <td>@item.ClaimStatus</td>
                    <td>
                        <form asp-action="MarkAsPaid" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@item.ClaimID" />
                            <button type="submit" class="btn btn-primary btn-sm">Mark as Paid</button>
                        </form>
                        <a asp-action="Invoice" asp-route-id="@item.ClaimID" class="btn btn-info btn-sm">View Invoice</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
